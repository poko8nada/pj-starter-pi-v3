{
  "name": "project-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "harness:pull": "node scripts/harness/index.mjs pull",
    "harness:push": "node scripts/harness/index.mjs push",
    "product:ready": "node scripts/product-ready/index.mjs",
    "test": "vitest --config vitest.starter.config.ts",
    "test:run": "vitest run --config vitest.starter.config.ts",
    "test:related": "vitest related --run --config vitest.starter.config.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "node scripts/checks/typecheck.mjs",
    "typecheck:staged": "node scripts/checks/typecheck-staged.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^26.6.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
