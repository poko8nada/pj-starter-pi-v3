#!/bin/sh
# 偽の pi。テストだけが使う。`--mode json` のふりをして JSONL を出す。
# stdin を読み切ってから `message_end`（assistant）と `agent_end` を出す。
# FAKE_PI_MODE: exit（終わる）/ sleep（眠り続ける）/ extra（もう1つ出して眠る）。無ければ何も出さず exit 2。
# FAKE_PI_TEXT: 本文の差し替え（既定 `fake report`）。

if [ -z "$FAKE_PI_MODE" ]; then
  exit 2
fi

# 指示は stdin から捨てる（本物と同じ口）。
cat > /dev/null

TEXT="${FAKE_PI_TEXT:-fake report}"
ESCAPED=$(printf '%s' "$TEXT" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')

printf '{"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"%s"}],"usage":{"output":10}}}\n' "$ESCAPED"
printf '{"type":"agent_end"}\n'

case "$FAKE_PI_MODE" in
  exit)
    exit 0
    ;;
  sleep)
    exec sleep 10000
    ;;
  extra)
    sleep 0.05
    printf '{"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"extra"}],"usage":{"output":1}}}\n'
    exec sleep 10000
    ;;
  *)
    exit 2
    ;;
esac
